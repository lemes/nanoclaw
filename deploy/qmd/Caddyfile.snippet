# install.sh appends this import to the (gitignored) Caddyfile:
#
#     import /Users/vin/.nanoclaw-qmd/qmd.caddy
#
# qmd.caddy is GENERATED by serve.sh (kept outside the repo because it contains
# per-group bearer tokens). It defines the single container-facing site:
#
#     :8182 {
#         @g_telegram_main header Authorization "Bearer <token-main>"
#         handle @g_telegram_main { reverse_proxy [::1]:8190 }
#         @g_telegram_yasmin header Authorization "Bearer <token-yasmin>"
#         handle @g_telegram_yasmin { reverse_proxy [::1]:8191 }
#         ...
#         respond "qmd: unauthorized" 403   # no/!wrong token => rejected
#     }
#
# Each group's container sends only its own token, so it can reach only its own
# isolated qmd instance (which is configured with only its own collection). The
# token requirement also means LAN/tailnet callers without a token get 403.
